# Copy to .env for `pnpm --filter api start`. db:* scripts inline their own DATABASE_URL.
NODE_ENV=development
PORT=3001
# Local docker-compose Postgres (host port 5442).
DATABASE_URL=postgresql://postgres:postgres@localhost:5442/school_erp?schema=public
# Origin of the web app allowed by CORS.
CORS_ORIGIN=http://localhost:3000
# Uploaded files (school logo…), served at /files/…
UPLOADS_DIR=uploads
# Signs access tokens. Required, 32+ characters, never committed. Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=
# Optional (defaults shown): access token seconds, refresh token days, reuse grace seconds.
# JWT_ACCESS_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=14
# REFRESH_REUSE_GRACE_SECONDS=10
# Secure flag on the session cookies; defaults to true in production.
# COOKIE_SECURE=false
# Proxies in front (docs/ARCHITECTURE.md → Security). Unset = trust none: the client IP is the
# socket's and X-Forwarded-For is ignored. On the server (Traefik → web → api on Docker networks):
# TRUST_PROXY=loopback, uniquelocal
# Behind Cloudflare, and only when the server's public ports accept nothing but Cloudflare:
# TRUST_CLOUDFLARE=true
# Rate limits, requests per window (defaults shown). A whole school may share one IP (an office
# NAT, or the app on its own server), so nothing people do normally is counted per IP at a low
# limit: per-IP figures are ceilings a NAT full of staff never reaches.
# RATE_LIMIT_TTL_SECONDS=60
# Every route, per signed-in user / per IP signed out (sign-in page, logo, app icons):
# RATE_LIMIT_GLOBAL=300
# RATE_LIMIT_GLOBAL_IP=1200
# Sign-in per email + IP; password change per user + IP; admin reset per target + IP
# (on top of the per-account lockout, 5 wrong in 15 min):
# RATE_LIMIT_AUTH=10
# Sign-ins, password changes and refreshes together per IP (stops password spraying):
# RATE_LIMIT_AUTH_IP=200
# Session refresh per session (refresh token):
# RATE_LIMIT_REFRESH=60
# Exports + uploads per user:
# RATE_LIMIT_HEAVY=20
# Seed only (`db:seed`): the HR admin's password. Required by the seed, no default.
# SEED_ADMIN_PASSWORD=
# Scheduled jobs (core/jobs) run on their clock; off under NODE_ENV=test. Default on.
# JOBS_ENABLED=true
# Push alerts (Web Push, VAPID). Optional: without them alerts are off ("not set up on this server").
# All three or none. Generate a pair: cd apps/api && node -e "console.log(require('web-push').generateVAPIDKeys())"
# (`pnpm run setup` does it for a fresh clone). Never committed; each environment has its own pair.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:it@example.com
