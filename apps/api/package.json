{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "prebuild": "pnpm --filter @school-erp/shared build",
    "build": "nest build",
    "prestart": "pnpm --filter @school-erp/shared build",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "db:generate": "prisma generate",
    "db:migrate": "DATABASE_URL=\"postgresql://postgres:postgres@localhost:${DB_PORT:-5442}/school_erp?schema=public\" prisma migrate dev",
    "db:migrate:create": "DATABASE_URL=\"postgresql://postgres:postgres@localhost:${DB_PORT:-5442}/school_erp?schema=public\" prisma migrate dev --create-only",
    "db:deploy": "DATABASE_URL=\"postgresql://postgres:postgres@localhost:${DB_PORT:-5442}/school_erp?schema=public\" prisma migrate deploy",
    "db:seed": "DATABASE_URL=\"postgresql://postgres:postgres@localhost:${DB_PORT:-5442}/school_erp?schema=public\" ts-node --transpile-only prisma/seed/index.ts",
    "db:studio": "DATABASE_URL=\"postgresql://postgres:postgres@localhost:${DB_PORT:-5442}/school_erp?schema=public\" prisma studio"
  },
  "dependencies": {
    "@nestjs-cls/transactional": "4.0.2",
    "@nestjs-cls/transactional-adapter-prisma": "2.0.2",
    "@nestjs/common": "11.2.10",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.10",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/mapped-types": "2.1.1",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.2.10",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/throttler": "6.7.1",
    "@prisma/client": "6.19.3",
    "@school-erp/shared": "workspace:*",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cron": "4.4.0",
    "exceljs": "4.4.0",
    "helmet": "8.3.0",
    "nestjs-cls": "7.0.2",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "12.0.13",
    "@nestjs/testing": "11.2.10",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/multer": "2.0.0",
    "@types/node": "22.20.5",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "6.0.3",
    "@types/web-push": "3.6.4",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.4.4",
    "globals": "16.5.0",
    "jest": "29.7.0",
    "prettier": "3.10.1",
    "prisma": "6.19.3",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": { "^.+\\.ts$": "ts-jest" },
    "moduleNameMapper": { "^@/(.*)$": "<rootDir>/$1" },
    "testEnvironment": "node"
  }
}
