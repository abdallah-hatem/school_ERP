// School ERP — one schema file, grouped by owning module (docs/ARCHITECTURE.md → Table ownership).
// Only the owning module writes its tables; any module may read them.
//
// Conventions: UUID ids · camelCase fields mapped to snake_case columns · money is Int piastres
// (EGP × 100) · day counts are Decimal(5,2) in 0.25 steps · every foreign key and filtered
// column is indexed · dates without time are @db.Date · months are 'YYYY-MM'.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── core ──────────────────────────────────────────────────────────────────────

/// A person who signs in. Not the same as an employee (R9: a user may be linked to one).
model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  passwordHash       String    @map("password_hash")
  name               String
  isActive           Boolean   @default(true) @map("is_active")
  /// Set by an admin's temporary password; cleared when the user changes it (R9). While set, the
  /// API answers only `/auth/me`, sign-out and `POST /account/password` (P3).
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  /// The last successful sign-in (P3, Users screen); null: never.
  lastSignInAt       DateTime? @map("last_sign_in_at")
  /// When the password was last set by an admin or changed by the user (P3); null: before P3.
  passwordChangedAt  DateTime? @map("password_changed_at")
  /// The linked employee (core-owned link, P2). Scopes (`own_stage`, `own_team`, `self`) read it.
  employeeId         String?   @unique @map("employee_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  linkedEmployee      Employee?                @relation("UserLinkedEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  roles               UserRoleAssignment[]
  refreshTokens       RefreshToken[]
  settingsUpdated     SchoolSetting[]
  penaltiesCreated    PenaltyRecord[]          @relation("PenaltyCreatedBy")
  penaltiesApproved   PenaltyRecord[]          @relation("PenaltyApprovedBy")
  penaltiesCancelled  PenaltyRecord[]          @relation("PenaltyCancelledBy")
  latenessUpdated     LatenessEntry[]
  payrollRunsCreated  PayrollRun[]             @relation("PayrollRunCreatedBy")
  payrollRunsApproved PayrollRun[]             @relation("PayrollRunApprovedBy")
  adjustmentsCreated  PayrollAdjustment[]
  notificationPrefs   NotificationPreference[]
  pushSubscriptions   PushSubscription[]

  @@index([isActive])
  @@map("users")
}

/// Grants of a role (R5): which rows each permission covers.
enum PermissionScope {
  all
  own_stage
  own_team
  self
}

/// A named set of permissions (R2). Built-in roles are the spec's starting roles: editable,
/// never deleted. Custom roles get a generated key.
model Role {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  nameEn    String   @map("name_en")
  nameAr    String   @map("name_ar")
  builtIn   Boolean  @default(false) @map("built_in")
  /// Listing order: built-in roles in the spec's order; custom roles keep 0 and sort by name.
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  users       UserRoleAssignment[]

  @@map("roles")
}

/// One permission of a role. `permissionKey` is text, not an enum: a key removed from the code
/// stays here until edited, and is ignored (and logged) when read (edge case 8).
model RolePermission {
  roleId        String          @map("role_id") @db.Uuid
  permissionKey String          @map("permission_key")
  scope         PermissionScope @default(all)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
  @@map("role_permissions")
}

/// Which roles a user holds (R2: several; permissions are the union).
model UserRoleAssignment {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// Refresh tokens, stored hashed. Rotation keeps a family; reuse after the grace window revokes it.
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  usedAt       DateTime? @map("used_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Wrong passwords per account (core/sign-in-limit, owner 2026-11-18), keyed by the lower-cased
/// email typed — an email nobody has gets a row too, so the answer never tells whether an account
/// exists. Per account only, never per IP. Written by one atomic upsert per wrong password; a
/// correct sign-in deletes the row; the nightly `login-attempts.cleanup` job deletes stale ones.
/// No foreign key: the email may belong to no user.
model LoginAttempt {
  email           String    @id
  failedCount     Int       @map("failed_count")
  windowStartedAt DateTime  @map("window_started_at")
  lockedUntil     DateTime? @map("locked_until")

  @@index([windowStartedAt])
  @@map("login_attempts")
}

/// One run of a scheduled job (core/jobs): written when it finishes, `success` or `failed` with
/// the error text. A run skipped because another API container held the job's lock writes nothing.
model JobRun {
  id         String   @id @default(uuid()) @db.Uuid
  jobName    String   @map("job_name")
  startedAt  DateTime @map("started_at")
  finishedAt DateTime @map("finished_at")
  /// `success` | `failed` (`JOB_RUN_STATUSES` in core/jobs).
  status     String
  error      String?

  @@index([jobName, startedAt])
  @@map("job_runs")
}

/// A must-deliver domain event (core/events, docs/ARCHITECTURE.md → Events). Written in the same
/// transaction as the change it announces; delivered to each outbox listener (`outbox_deliveries`).
/// `status`: `pending` | `delivered` (every delivery done, or no listener) | `dead` (a delivery gave
/// up). Delivered events are deleted after 30 days by `outbox.cleanup`; dead ones are kept.
model OutboxEvent {
  id         String           @id @default(uuid()) @db.Uuid
  /// Creation order: deliveries go out in this order.
  seq        BigInt           @unique @default(autoincrement())
  name       String
  payload    Json
  createdAt  DateTime         @default(now()) @map("created_at")
  status     String
  deliveries OutboxDelivery[]

  @@index([status, createdAt])
  @@map("outbox_events")
}

/// One listener's delivery of an outbox event. `status`: `pending` | `delivered` | `dead` (after 10
/// failures). `attempts` counts the tries made; `next_attempt_at` is when it is due (or, while a
/// worker holds it, when that worker's lease ends).
model OutboxDelivery {
  id            String      @id @default(uuid()) @db.Uuid
  eventId       String      @map("event_id") @db.Uuid
  event         OutboxEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  listener      String
  status        String
  attempts      Int         @default(0)
  nextAttemptAt DateTime    @map("next_attempt_at")
  lastError     String?     @map("last_error")
  deliveredAt   DateTime?   @map("delivered_at")

  @@unique([eventId, listener])
  @@index([status, nextAttemptAt])
  @@map("outbox_deliveries")
}

/// One notification in a person's bell (core/notifications, §11): one or more items of one type
/// (N17 — items join the recipient's open, unread notification of the same type and group key).
/// `recipient_kind` + `recipient_id` (N6): `user` now, a parent or student `contact` later — no
/// foreign key, so the shape stays. `resolved_at` is set when its last open item is resolved.
/// Deleted by the nightly `core.notifications.purge` (read > 90 days, resolved > 30, any > 365).
model Notification {
  id            String                 @id @default(uuid()) @db.Uuid
  type          String
  recipientKind String                 @map("recipient_kind")
  recipientId   String                 @map("recipient_id") @db.Uuid
  /// The type's grouping key (the school day by default): items of one key join one notification.
  groupKey      String                 @map("group_key")
  /// Who caused the first item; null for a reminder.
  actorId       String?                @map("actor_id") @db.Uuid
  createdAt     DateTime               @default(now()) @map("created_at")
  /// When its latest item arrived (the list's order; "mark all read" up to a moment).
  updatedAt     DateTime               @map("updated_at")
  readAt        DateTime?              @map("read_at")
  resolvedAt    DateTime?              @map("resolved_at")
  items         NotificationItem[]
  deliveries    NotificationDelivery[]

  @@index([recipientKind, recipientId, updatedAt(sort: Desc)])
  @@index([recipientKind, recipientId, readAt, resolvedAt])
  @@index([recipientKind, recipientId, type, groupKey])
  @@index([readAt])
  @@index([resolvedAt])
  @@index([createdAt])
  @@map("notifications")
}

/// One thing a notification is about (a penalty, a contract, a month). `recipient_*` and `type` are
/// copied from the notification for the dedupe index (N9): a second send of the same item to the
/// same person is a no-op. `params` holds the sentence's values (names as `{ en, ar }`), never a
/// sentence (N3). `employee_id` is the employee it concerns, for the scope re-check (N11).
model NotificationItem {
  id             String       @id @default(uuid()) @db.Uuid
  notificationId String       @map("notification_id") @db.Uuid
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  recipientKind  String       @map("recipient_kind")
  recipientId    String       @map("recipient_id") @db.Uuid
  type           String
  entityType     String       @map("entity_type")
  entityId       String       @map("entity_id")
  employeeId     String?      @map("employee_id") @db.Uuid
  params         Json         @default("{}")
  dedupeKey      String       @map("dedupe_key")
  createdAt      DateTime     @default(now()) @map("created_at")
  resolvedAt     DateTime?    @map("resolved_at")
  /// Who resolved it, as their name was then: `{ en, ar }`; null for no person (a job).
  resolvedByName Json?        @map("resolved_by_name")
  /// `approved` | `cancelled` | `done`.
  resolution     String?

  @@unique([recipientKind, recipientId, type, dedupeKey])
  @@index([type, entityType, entityId, resolvedAt])
  @@index([notificationId])
  @@map("notification_items")
}

/// One notification per channel enabled for the person when it was made (N8). `in_app` is `sent`
/// at once; later channels pick `pending` rows up after the commit. `status`: `pending` | `sent` |
/// `failed` | `skipped`.
model NotificationDelivery {
  id             String       @id @default(uuid()) @db.Uuid
  notificationId String       @map("notification_id") @db.Uuid
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel        String
  status         String
  attempts       Int          @default(0)
  lastError      String?      @map("last_error")
  sentAt         DateTime?    @map("sent_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([notificationId, channel])
  @@index([channel, status])
  @@map("notification_deliveries")
}

/// The school's default per type and channel (Settings → Notifications). No row: the type's own default.
model NotificationDefault {
  type        String
  channel     String
  enabled     Boolean
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@id([type, channel])
  @@map("notification_defaults")
}

/// A person's own choice per type and channel (My account → Notifications). No row: the school's default.
model NotificationPreference {
  userId    String   @map("user_id") @db.Uuid
  type      String
  channel   String
  enabled   Boolean
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type, channel])
  @@map("notification_preferences")
}

/// A device that gets a person's notifications as Web Push alerts (§11, owner 2026-11-21): one row
/// per browser push subscription. `endpoint` is the push service's URL for that browser (unique: a
/// browser shared by two accounts belongs to whoever turned alerts on last). Removed by the person,
/// or by the sender when the push service answers 404 / 410 (the subscription is gone): then
/// `revoked_at` is set and nothing is sent to it again. `locale` is the app's language on that
/// device, the language its alerts are written in.
model PushSubscription {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  endpoint      String    @unique
  /// SHA-256 of `endpoint`, hex, cut to 32: the browser finds "this device" without seeing endpoints.
  endpointHash  String    @map("endpoint_hash")
  p256dh        String
  auth          String
  /// "Chrome", "Safari"… and "Android", "iPhone"… from the user agent when it was added.
  browser       String?
  os            String?
  locale        String    @default("en")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  /// The last alert the push service accepted for it.
  lastUsedAt    DateTime? @map("last_used_at")
  revokedAt     DateTime? @map("revoked_at")
  /// `removed` (by the person) | `expired` (404 / 410 from the push service) | `replaced` (over the limit).
  revokedReason String?   @map("revoked_reason")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("push_subscriptions")
}

/// Named monotonic counters (e.g. 'employee_code'). Incremented atomically; values never reused.
model Counter {
  name      String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("counters")
}

/// One row per setting key (see `SchoolSettingKey` / `HrSettingKey` in @school-erp/shared).
/// A missing row means the default from `SETTING_DEFAULTS`.
model SchoolSetting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
  @@map("school_settings")
}

/// The audit log (§9, core/audit): one row per action that changed data or access, written in the
/// same transaction as the change. Append-only — a trigger refuses UPDATE, DELETE and TRUNCATE.
/// `actorId` is deliberately not a foreign key: users may be renamed or deleted later, and the
/// entry keeps `actorName` as it was (edge case 4). `changes` holds only the changed fields
/// (`[{ field, before, after }]`, money in piastres, no secrets); `meta` holds ip, user agent and
/// request id. `seq` orders entries written in the same millisecond.
model AuditEntry {
  id            String   @id @default(uuid()) @db.Uuid
  seq           BigInt   @default(autoincrement())
  action        String
  module        String
  entityType    String   @map("entity_type")
  entityId      String   @map("entity_id")
  /// The record's name when the entry was written: English (or its only name)…
  entityLabel   String   @map("entity_label")
  /// …and Arabic, when the record has one. Null on one-name records and on older entries.
  entityLabelAr String?  @map("entity_label_ar")
  actorId       String?  @map("actor_id") @db.Uuid
  actorName     String?  @map("actor_name")
  changes       Json     @default("[]")
  meta          Json     @default("{}")
  at            DateTime @default(now())

  @@index([at(sort: Desc)])
  @@index([entityType, entityId, at])
  @@index([actorId, at])
  @@index([module, at])
  @@index([action, at])
  @@map("audit_entries")
}

/// School structure (core/school-structure): Kindergarten, Primary, Preparatory, None…
model Stage {
  id        String   @id @default(uuid()) @db.Uuid
  nameEn    String   @map("name_en")
  nameAr    String   @map("name_ar")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  /// The "no stage" entry (staff not tied to a stage, §3): at most one stage, marked by the seed (or
  /// by the migration that added the flag), never recognised by name. Renaming it keeps the role.
  isNoStage Boolean  @default(false) @map("is_no_stage")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employees Employee[]

  @@index([isActive])
  @@index([sortOrder])
  @@map("stages")
}

// ── hr ────────────────────────────────────────────────────────────────────────

enum WorkSystem {
  FULL_TIME
  PART_TIME_4
  PART_TIME_3
  PART_TIME_2
}

enum Gender {
  MALE
  FEMALE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum InsuranceStatus {
  INSURED
  NOT_INSURED
}

enum Degree {
  NONE
  SECONDARY
  DIPLOMA
  BACHELOR
  MASTER
  DOCTORATE
}

enum PenaltyAction {
  NOTICE
  WARNING
  DEDUCT_DAYS
  INVESTIGATION
  RAISE_HALF_LOSS
  RAISE_LOSS
  RAISE_DEFER_3M
  PAY_CUT
  DEMOTION
  DISMISSAL
}

enum PenaltyStatus {
  PENDING
  APPROVED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  APPROVED
}

enum AdjustmentType {
  ADDITION
  DEDUCTION
}

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  nameEn    String   @map("name_en")
  nameAr    String   @map("name_ar")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employees Employee[]

  @@index([isActive])
  @@index([sortOrder])
  @@map("departments")
}

/// §3. `managesPeople`: holders of this title can be chosen as a direct manager (2026-11-18).
model JobTitle {
  id            String   @id @default(uuid()) @db.Uuid
  nameEn        String   @map("name_en")
  nameAr        String   @map("name_ar")
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  managesPeople Boolean  @default(false) @map("manages_people")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  employees Employee[]

  @@index([isActive])
  @@index([managesPeople])
  @@index([sortOrder])
  @@map("job_titles")
}

/// §3. Never deleted — deactivated. `code` comes from the 'employee_code' Counter (EMP-0001…).
model Employee {
  id                           String          @id @default(uuid()) @db.Uuid
  code                         String          @unique
  nameEn                       String          @map("name_en")
  nameAr                       String          @map("name_ar")
  nationalId                   String?         @unique @map("national_id")
  gender                       Gender
  dateOfBirth                  DateTime        @map("date_of_birth") @db.Date
  phone                        String
  email                        String?
  address                      String?
  hireDate                     DateTime        @map("hire_date") @db.Date
  stageId                      String          @map("stage_id") @db.Uuid
  departmentId                 String          @map("department_id") @db.Uuid
  jobTitleId                   String          @map("job_title_id") @db.Uuid
  managerId                    String?         @map("manager_id") @db.Uuid
  grade                        String?
  workSystem                   WorkSystem      @map("work_system")
  /// Monthly, piastres.
  basicSalary                  Int             @map("basic_salary")
  fingerprintId                String?         @unique @map("fingerprint_id")
  contractStart                DateTime        @map("contract_start") @db.Date
  contractEnd                  DateTime        @map("contract_end") @db.Date
  /// §3 (N0): hire date + the default probation length unless given; null = no probation.
  probationEnd                 DateTime?       @map("probation_end") @db.Date
  usesBus                      Boolean         @default(false) @map("uses_bus")
  /// `/files/employee-photos/<name>`, signed-in only. Null shows the silhouette.
  photoUrl                     String?         @map("photo_url")
  /// Social insurance (§3). Not insured → the three fields below are null.
  insuranceStatus              InsuranceStatus @default(NOT_INSURED) @map("insurance_status")
  insuranceNumber              String?         @unique @map("insurance_number")
  insuranceRegistrationDate    DateTime?       @map("insurance_registration_date") @db.Date
  /// Monthly, piastres.
  insuredSalary                Int?            @map("insured_salary")
  bankName                     String?         @map("bank_name")
  bankAccountNumber            String?         @map("bank_account_number")
  iban                         String?
  emergencyContactName         String?         @map("emergency_contact_name")
  emergencyContactRelationship String?         @map("emergency_contact_relationship")
  emergencyContactPhone        String?         @map("emergency_contact_phone")
  highestDegree                Degree?         @map("highest_degree")
  major                        String?
  university                   String?
  graduationYear               Int?            @map("graduation_year")
  status                       EmployeeStatus  @default(ACTIVE)
  /// The school day the employee was last deactivated (a leaver on the dashboard charts); null
  /// while active — reactivating clears it.
  deactivatedOn                DateTime?       @map("deactivated_on") @db.Date
  createdAt                    DateTime        @default(now()) @map("created_at")
  updatedAt                    DateTime        @updatedAt @map("updated_at")

  stage      Stage      @relation(fields: [stageId], references: [id], onDelete: Restrict)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  jobTitle   JobTitle   @relation(fields: [jobTitleId], references: [id], onDelete: Restrict)
  manager    Employee?  @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: Restrict)
  reports    Employee[] @relation("EmployeeManager")
  linkedUser User?      @relation("UserLinkedEmployee")

  penalties    PenaltyRecord[]
  lateness     LatenessEntry[]
  payrollLines PayrollLine[]
  adjustments  PayrollAdjustment[]

  @@index([stageId])
  @@index([departmentId])
  @@index([jobTitleId])
  @@index([managerId])
  @@index([status])
  @@index([workSystem])
  @@index([hireDate])
  @@index([deactivatedOn])
  @@map("employees")
}

/// A table of the penalty regulations (§4), e.g. general table A.
model PenaltyGroup {
  id        String   @id @default(uuid()) @db.Uuid
  nameEn    String   @map("name_en")
  nameAr    String   @map("name_ar")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  violations Violation[]

  @@index([isActive])
  @@index([sortOrder])
  @@map("penalty_groups")
}

/// A catalogue violation. Retired (`isActive: false`), never deleted.
model Violation {
  id         String   @id @default(uuid()) @db.Uuid
  groupId    String   @map("group_id") @db.Uuid
  nameEn     String   @map("name_en")
  nameAr     String   @map("name_ar")
  /// Free text kept for the reviewer, e.g. "doubles on repeat".
  note       String?
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")
  /// §4: at most one pending/approved penalty per employee per date (off for violations that
  /// repeat within a day, e.g. late to class).
  oncePerDay Boolean  @default(true) @map("once_per_day")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  group     PenaltyGroup     @relation(fields: [groupId], references: [id], onDelete: Restrict)
  levels    ViolationLevel[]
  penalties PenaltyRecord[]

  @@index([groupId])
  @@index([isActive])
  @@map("violations")
}

/// Level 1–5 of a violation: the action for the n-th occurrence.
model ViolationLevel {
  id          String        @id @default(uuid()) @db.Uuid
  violationId String        @map("violation_id") @db.Uuid
  level       Int
  action      PenaltyAction
  /// Required (> 0) for DEDUCT_DAYS, optional for INVESTIGATION, null otherwise.
  days        Decimal?      @db.Decimal(5, 2)

  violation Violation @relation(fields: [violationId], references: [id], onDelete: Cascade)

  @@unique([violationId, level])
  @@index([violationId])
  @@map("violation_levels")
}

/// A recorded penalty. Level, action and days are computed at creation, shown from the catalogue
/// while PENDING, and fixed at approval. Never deleted.
model PenaltyRecord {
  id            String        @id @default(uuid()) @db.Uuid
  employeeId    String        @map("employee_id") @db.Uuid
  violationId   String        @map("violation_id") @db.Uuid
  /// The day the violation happened; its month is the payroll month it affects.
  date          DateTime      @db.Date
  status        PenaltyStatus @default(PENDING)
  level         Int
  action        PenaltyAction
  days          Decimal?      @db.Decimal(5, 2)
  note          String?
  cancelReason  String?       @map("cancel_reason")
  createdById   String?       @map("created_by_id") @db.Uuid
  approvedById  String?       @map("approved_by_id") @db.Uuid
  approvedAt    DateTime?     @map("approved_at")
  cancelledById String?       @map("cancelled_by_id") @db.Uuid
  cancelledAt   DateTime?     @map("cancelled_at")
  /// When a backdated approval last moved this approved penalty up a level (§4, owner 2026-11-20):
  /// a draft payroll run calculated before it is due a Recalculate.
  recountedAt   DateTime?     @map("recounted_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  violation   Violation @relation(fields: [violationId], references: [id], onDelete: Restrict)
  createdBy   User?     @relation("PenaltyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy  User?     @relation("PenaltyApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  cancelledBy User?     @relation("PenaltyCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([violationId])
  @@index([date])
  @@index([status])
  @@index([createdById])
  @@index([approvedById])
  @@index([cancelledById])
  /// Repeat-level count: approved records of one violation for one employee in a date window.
  @@index([employeeId, violationId, status, date])
  @@map("penalty_records")
}

/// Accumulated late / early-leave minutes for one employee in one month (§5).
model LatenessEntry {
  id          String   @id @default(uuid()) @db.Uuid
  employeeId  String   @map("employee_id") @db.Uuid
  /// 'YYYY-MM'
  month       String   @db.Char(7)
  minutes     Int
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  updatedBy User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([employeeId, month])
  @@index([employeeId])
  @@index([month])
  @@index([updatedById])
  @@map("lateness_entries")
}

/// One run per month (§6). DRAFT until approved; an approved run is never edited.
model PayrollRun {
  id            String        @id @default(uuid()) @db.Uuid
  /// 'YYYY-MM'
  month         String        @unique @db.Char(7)
  status        PayrollStatus @default(DRAFT)
  calculatedAt  DateTime      @default(now()) @map("calculated_at")
  createdById   String?       @map("created_by_id") @db.Uuid
  approvedById  String?       @map("approved_by_id") @db.Uuid
  approvedAt    DateTime?     @map("approved_at")
  /// Accounting marked the salaries transferred (finalized, §10): the run is final.
  transferredAt DateTime?     @map("transferred_at")
  /// The last time Accounting sent the run back to HR (a draft again), and why. Cleared on approval.
  returnedAt    DateTime?     @map("returned_at")
  returnReason  String?       @map("return_reason")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  createdBy   User?               @relation("PayrollRunCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy  User?               @relation("PayrollRunApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  lines       PayrollLine[]
  adjustments PayrollAdjustment[]

  @@index([status])
  @@index([createdById])
  @@index([approvedById])
  @@map("payroll_runs")
}

/// One employee's line in a run. Every employee and department field is a SNAPSHOT taken at
/// calculation — editing the employee later never changes it.
model PayrollLine {
  id                   String          @id @default(uuid()) @db.Uuid
  runId                String          @map("run_id") @db.Uuid
  employeeId           String          @map("employee_id") @db.Uuid
  employeeCode         String          @map("employee_code")
  nameEn               String          @map("name_en")
  nameAr               String          @map("name_ar")
  nationalId           String?         @map("national_id")
  /// Snapshot of the employee's department id (plain column, not a relation).
  departmentId         String          @map("department_id") @db.Uuid
  departmentNameEn     String          @map("department_name_en")
  departmentNameAr     String          @map("department_name_ar")
  basicSalary          Int             @map("basic_salary")
  workSystem           WorkSystem      @map("work_system")
  monthSalary          Int             @map("month_salary")
  /// Rounded for display; deductions use monthSalary ÷ divisor unrounded.
  dayValue             Int             @map("day_value")
  penaltyDays          Decimal         @default(0) @map("penalty_days") @db.Decimal(5, 2)
  penaltyAmount        Int             @default(0) @map("penalty_amount")
  latenessMinutes      Int             @default(0) @map("lateness_minutes")
  /// The lateness grace taken off the minutes at this calculation (§5). Null on lines calculated
  /// before it was kept (the payslip then shows the minutes without it).
  latenessGraceMinutes Int?            @map("lateness_grace_minutes")
  latenessDays         Decimal         @default(0) @map("lateness_days") @db.Decimal(5, 2)
  latenessAmount       Int             @default(0) @map("lateness_amount")
  adjustmentAdditions  Int             @default(0) @map("adjustment_additions")
  adjustmentDeductions Int             @default(0) @map("adjustment_deductions")
  net                  Int
  /// Snapshot of the employee's social insurance (§3), retaken at approval — what accounting
  /// works the month's taxes out from (§10), whenever it does.
  insuranceStatus      InsuranceStatus @map("insurance_status")
  insuredSalary        Int?            @map("insured_salary")
  /// `PayrollFlag` values: NET_FLOORED, PENDING_PENALTIES.
  flags                String[]        @default([])
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  run      PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([runId, employeeId])
  @@index([runId])
  @@index([employeeId])
  @@index([departmentId])
  @@map("payroll_lines")
}

/// A one-off addition or deduction on a draft run, with a required reason (§6).
model PayrollAdjustment {
  id          String         @id @default(uuid()) @db.Uuid
  runId       String         @map("run_id") @db.Uuid
  employeeId  String         @map("employee_id") @db.Uuid
  type        AdjustmentType
  /// Piastres, > 0.
  amount      Int
  reason      String
  createdById String?        @map("created_by_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at")

  run       PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee  Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdBy User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([runId])
  @@index([employeeId])
  @@index([createdById])
  @@map("payroll_adjustments")
}

// ── accounting (§10) ───────────────────────────────────────────────────────

/// One approved HR payroll month as accounting sees it: worked out once, when HR approved it, and
/// frozen. `taxRule` is the accounting tax rule in force then. Accounting writes only its tables.
model AccountingPayrollRun {
  id            String    @id @default(uuid()) @db.Uuid
  /// The approved HR run (plain id, not a relation — accounting reads HR only through its service).
  hrRunId       String    @unique @map("hr_run_id") @db.Uuid
  month         String    @unique @db.Char(7)
  taxRule       Json      @map("tax_rule")
  recordedAt    DateTime  @default(now()) @map("recorded_at")
  /// The salaries were transferred: the month is final and can't be returned to HR. Null: pending.
  finalizedAt   DateTime? @map("finalized_at")
  /// Who finalized it (plain user id; the audit log has the details).
  finalizedById String?   @map("finalized_by_id") @db.Uuid

  lines AccountingPayrollLine[]

  @@map("accounting_payroll_runs")
}

/// Every version of the payroll tax rule (§10), from the moment it took effect: an approved month
/// is worked out with the version in force at its approval, even when that happens later.
model AccountingTaxRuleVersion {
  id            String   @id @default(uuid()) @db.Uuid
  rule          Json
  effectiveFrom DateTime @default(now()) @map("effective_from")
  /// Who saved it (plain id; the audit log has the details). Null for the baseline.
  changedById   String?  @map("changed_by_id") @db.Uuid

  @@index([effectiveFrom])
  @@map("accounting_tax_rule_versions")
}

/// One employee's taxes for an approved month. Employee fields and insurance are a SNAPSHOT at
/// approval. gross = net + insuranceAmount + incomeTax + martyrTax.
model AccountingPayrollLine {
  id              String          @id @default(uuid()) @db.Uuid
  runId           String          @map("run_id") @db.Uuid
  employeeId      String          @map("employee_id") @db.Uuid
  employeeCode    String          @map("employee_code")
  nameEn          String          @map("name_en")
  nameAr          String          @map("name_ar")
  net             Int
  insuranceStatus InsuranceStatus @map("insurance_status")
  insuredSalary   Int?            @map("insured_salary")
  insuranceAmount Int             @map("insurance_amount")
  incomeTax       Int             @map("income_tax")
  martyrTax       Int             @map("martyr_tax")
  gross           Int

  run AccountingPayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, employeeId])
  @@index([runId])
  @@map("accounting_payroll_lines")
}
