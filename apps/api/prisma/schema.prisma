// School ERP — one schema file, grouped by owning module (docs/ARCHITECTURE.md → Table ownership).
// Only the owning module writes its tables; any module may read them.
//
// Conventions: UUID ids · camelCase fields mapped to snake_case columns · money is Int piastres
// (EGP × 100) · day counts are Decimal(5,2) in 0.25 steps · every foreign key and filtered
// column is indexed · dates without time are @db.Date · months are 'YYYY-MM'.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── core ──────────────────────────────────────────────────────────────────────

/// Deprecated since P2: access comes from `user_roles`. Kept until the web app stops reading
/// `AuthUser.role` (P3); nothing decides access with it.
enum UserRole {
  HR_ADMIN
}

/// A person who signs in. Not the same as an employee (R9: a user may be linked to one).
model User {
  id                 String   @id @default(uuid()) @db.Uuid
  email              String   @unique
  passwordHash       String   @map("password_hash")
  name               String
  /// Deprecated (P2) — see `UserRole`.
  role               UserRole @default(HR_ADMIN)
  isActive           Boolean  @default(true) @map("is_active")
  /// Set by an admin's temporary password; cleared when the user changes it (R9).
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  /// The linked employee (core-owned link, P2). Scopes (`own_stage`, `own_team`, `self`) read it.
  employeeId         String?  @unique @map("employee_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  linkedEmployee      Employee?            @relation("UserLinkedEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  roles               UserRoleAssignment[]
  refreshTokens       RefreshToken[]
  /// Deprecated (P2): HR's old `employees.user_id` link, copied into `employeeId`.
  employee            Employee?            @relation("EmployeeUser")
  settingsUpdated     SchoolSetting[]
  penaltiesCreated    PenaltyRecord[]      @relation("PenaltyCreatedBy")
  penaltiesApproved   PenaltyRecord[]      @relation("PenaltyApprovedBy")
  penaltiesCancelled  PenaltyRecord[]      @relation("PenaltyCancelledBy")
  latenessUpdated     LatenessEntry[]
  payrollRunsCreated  PayrollRun[]         @relation("PayrollRunCreatedBy")
  payrollRunsApproved PayrollRun[]         @relation("PayrollRunApprovedBy")
  adjustmentsCreated  PayrollAdjustment[]

  @@index([isActive])
  @@map("users")
}

/// Grants of a role (R5): which rows each permission covers.
enum PermissionScope {
  all
  own_stage
  own_team
  self
}

/// A named set of permissions (R2). Built-in roles are the spec's starting roles: editable,
/// never deleted. Custom roles get a generated key.
model Role {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  nameEn    String   @map("name_en")
  nameAr    String   @map("name_ar")
  builtIn   Boolean  @default(false) @map("built_in")
  /// Listing order: built-in roles in the spec's order; custom roles keep 0 and sort by name.
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  users       UserRoleAssignment[]

  @@map("roles")
}

/// One permission of a role. `permissionKey` is text, not an enum: a key removed from the code
/// stays here until edited, and is ignored (and logged) when read (edge case 8).
model RolePermission {
  roleId        String          @map("role_id") @db.Uuid
  permissionKey String          @map("permission_key")
  scope         PermissionScope @default(all)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
  @@map("role_permissions")
}

/// Which roles a user holds (R2: several; permissions are the union).
model UserRoleAssignment {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// Refresh tokens, stored hashed. Rotation keeps a family; reuse after the grace window revokes it.
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  usedAt       DateTime? @map("used_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Named monotonic counters (e.g. 'employee_code'). Incremented atomically; values never reused.
model Counter {
  name      String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("counters")
}

/// One row per setting key (see `SchoolSettingKey` / `HrSettingKey` in @school-erp/shared).
/// A missing row means the default from `SETTING_DEFAULTS`.
model SchoolSetting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
  @@map("school_settings")
}

/// The audit log (§9, core/audit): one row per action that changed data or access, written in the
/// same transaction as the change. Append-only — a trigger refuses UPDATE, DELETE and TRUNCATE.
/// `actorId` is deliberately not a foreign key: users may be renamed or deleted later, and the
/// entry keeps `actorName` as it was (edge case 4). `changes` holds only the changed fields
/// (`[{ field, before, after }]`, money in piastres, no secrets); `meta` holds ip, user agent and
/// request id. `seq` orders entries written in the same millisecond.
model AuditEntry {
  id          String   @id @default(uuid()) @db.Uuid
  seq         BigInt   @default(autoincrement())
  action      String
  module      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  entityLabel String   @map("entity_label")
  actorId     String?  @map("actor_id") @db.Uuid
  actorName   String?  @map("actor_name")
  changes     Json     @default("[]")
  meta        Json     @default("{}")
  at          DateTime @default(now())

  @@index([at(sort: Desc)])
  @@index([entityType, entityId, at])
  @@index([actorId, at])
  @@index([module, at])
  @@index([action, at])
  @@map("audit_entries")
}

/// School structure (core/school-structure): Kindergarten, Primary, Preparatory, None…
model Stage {
  id        String   @id @default(uuid()) @db.Uuid
  nameEn    String   @map("name_en")
  nameAr    String   @map("name_ar")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employees Employee[]

  @@index([isActive])
  @@index([sortOrder])
  @@map("stages")
}

// ── hr ────────────────────────────────────────────────────────────────────────

enum WorkSystem {
  FULL_TIME
  PART_TIME_4
  PART_TIME_3
  PART_TIME_2
}

enum Gender {
  MALE
  FEMALE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum PenaltyAction {
  NOTICE
  WARNING
  DEDUCT_DAYS
  INVESTIGATION
  RAISE_HALF_LOSS
  RAISE_LOSS
  RAISE_DEFER_3M
  PAY_CUT
  DEMOTION
  DISMISSAL
}

enum PenaltyStatus {
  PENDING
  APPROVED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  APPROVED
}

enum AdjustmentType {
  ADDITION
  DEDUCTION
}

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  nameEn    String   @map("name_en")
  nameAr    String   @map("name_ar")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employees Employee[]

  @@index([isActive])
  @@index([sortOrder])
  @@map("departments")
}

model JobTitle {
  id        String   @id @default(uuid()) @db.Uuid
  nameEn    String   @map("name_en")
  nameAr    String   @map("name_ar")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employees Employee[]

  @@index([isActive])
  @@index([sortOrder])
  @@map("job_titles")
}

/// §3. Never deleted — deactivated. `code` comes from the 'employee_code' Counter (EMP-0001…).
model Employee {
  id            String         @id @default(uuid()) @db.Uuid
  code          String         @unique
  nameEn        String         @map("name_en")
  nameAr        String         @map("name_ar")
  nationalId    String?        @unique @map("national_id")
  gender        Gender
  dateOfBirth   DateTime       @map("date_of_birth") @db.Date
  phone         String
  email         String?
  address       String?
  hireDate      DateTime       @map("hire_date") @db.Date
  stageId       String         @map("stage_id") @db.Uuid
  departmentId  String         @map("department_id") @db.Uuid
  jobTitleId    String         @map("job_title_id") @db.Uuid
  managerId     String?        @map("manager_id") @db.Uuid
  grade         String?
  workSystem    WorkSystem     @map("work_system")
  /// Monthly, piastres.
  basicSalary   Int            @map("basic_salary")
  fingerprintId String?        @unique @map("fingerprint_id")
  contractStart DateTime       @map("contract_start") @db.Date
  contractEnd   DateTime       @map("contract_end") @db.Date
  usesBus       Boolean        @default(false) @map("uses_bus")
  status        EmployeeStatus @default(ACTIVE)
  userId        String?        @unique @map("user_id") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  stage      Stage      @relation(fields: [stageId], references: [id], onDelete: Restrict)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  jobTitle   JobTitle   @relation(fields: [jobTitleId], references: [id], onDelete: Restrict)
  manager    Employee?  @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: Restrict)
  reports    Employee[] @relation("EmployeeManager")
  user       User?      @relation("EmployeeUser", fields: [userId], references: [id], onDelete: SetNull)
  linkedUser User?      @relation("UserLinkedEmployee")

  penalties    PenaltyRecord[]
  lateness     LatenessEntry[]
  payrollLines PayrollLine[]
  adjustments  PayrollAdjustment[]

  @@index([stageId])
  @@index([departmentId])
  @@index([jobTitleId])
  @@index([managerId])
  @@index([status])
  @@index([workSystem])
  @@map("employees")
}

/// A table of the penalty regulations (§4), e.g. general table A.
model PenaltyGroup {
  id        String   @id @default(uuid()) @db.Uuid
  nameEn    String   @map("name_en")
  nameAr    String   @map("name_ar")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  violations Violation[]

  @@index([isActive])
  @@index([sortOrder])
  @@map("penalty_groups")
}

/// A catalogue violation. Retired (`isActive: false`), never deleted.
model Violation {
  id        String   @id @default(uuid()) @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  nameEn    String   @map("name_en")
  nameAr    String   @map("name_ar")
  /// Free text kept for the reviewer, e.g. "doubles on repeat".
  note      String?
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  group     PenaltyGroup     @relation(fields: [groupId], references: [id], onDelete: Restrict)
  levels    ViolationLevel[]
  penalties PenaltyRecord[]

  @@index([groupId])
  @@index([isActive])
  @@map("violations")
}

/// Level 1–5 of a violation: the action for the n-th occurrence.
model ViolationLevel {
  id          String        @id @default(uuid()) @db.Uuid
  violationId String        @map("violation_id") @db.Uuid
  level       Int
  action      PenaltyAction
  /// Required (> 0) for DEDUCT_DAYS, optional for INVESTIGATION, null otherwise.
  days        Decimal?      @db.Decimal(5, 2)

  violation Violation @relation(fields: [violationId], references: [id], onDelete: Cascade)

  @@unique([violationId, level])
  @@index([violationId])
  @@map("violation_levels")
}

/// A recorded penalty. Level, action and days are computed at creation, shown from the catalogue
/// while PENDING, and fixed at approval. Never deleted.
model PenaltyRecord {
  id            String        @id @default(uuid()) @db.Uuid
  employeeId    String        @map("employee_id") @db.Uuid
  violationId   String        @map("violation_id") @db.Uuid
  /// The day the violation happened; its month is the payroll month it affects.
  date          DateTime      @db.Date
  status        PenaltyStatus @default(PENDING)
  level         Int
  action        PenaltyAction
  days          Decimal?      @db.Decimal(5, 2)
  note          String?
  cancelReason  String?       @map("cancel_reason")
  createdById   String?       @map("created_by_id") @db.Uuid
  approvedById  String?       @map("approved_by_id") @db.Uuid
  approvedAt    DateTime?     @map("approved_at")
  cancelledById String?       @map("cancelled_by_id") @db.Uuid
  cancelledAt   DateTime?     @map("cancelled_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  violation   Violation @relation(fields: [violationId], references: [id], onDelete: Restrict)
  createdBy   User?     @relation("PenaltyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy  User?     @relation("PenaltyApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  cancelledBy User?     @relation("PenaltyCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([violationId])
  @@index([date])
  @@index([status])
  @@index([createdById])
  @@index([approvedById])
  @@index([cancelledById])
  /// Repeat-level count: approved records of one violation for one employee in a date window.
  @@index([employeeId, violationId, status, date])
  @@map("penalty_records")
}

/// Accumulated late / early-leave minutes for one employee in one month (§5).
model LatenessEntry {
  id          String   @id @default(uuid()) @db.Uuid
  employeeId  String   @map("employee_id") @db.Uuid
  /// 'YYYY-MM'
  month       String   @db.Char(7)
  minutes     Int
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  updatedBy User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([employeeId, month])
  @@index([employeeId])
  @@index([month])
  @@index([updatedById])
  @@map("lateness_entries")
}

/// One run per month (§6). DRAFT until approved; an approved run is never edited.
model PayrollRun {
  id           String        @id @default(uuid()) @db.Uuid
  /// 'YYYY-MM'
  month        String        @unique @db.Char(7)
  status       PayrollStatus @default(DRAFT)
  calculatedAt DateTime      @default(now()) @map("calculated_at")
  createdById  String?       @map("created_by_id") @db.Uuid
  approvedById String?       @map("approved_by_id") @db.Uuid
  approvedAt   DateTime?     @map("approved_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  createdBy   User?               @relation("PayrollRunCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy  User?               @relation("PayrollRunApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  lines       PayrollLine[]
  adjustments PayrollAdjustment[]

  @@index([status])
  @@index([createdById])
  @@index([approvedById])
  @@map("payroll_runs")
}

/// One employee's line in a run. Every employee and department field is a SNAPSHOT taken at
/// calculation — editing the employee later never changes it.
model PayrollLine {
  id                   String     @id @default(uuid()) @db.Uuid
  runId                String     @map("run_id") @db.Uuid
  employeeId           String     @map("employee_id") @db.Uuid
  employeeCode         String     @map("employee_code")
  nameEn               String     @map("name_en")
  nameAr               String     @map("name_ar")
  nationalId           String?    @map("national_id")
  /// Snapshot of the employee's department id (plain column, not a relation).
  departmentId         String     @map("department_id") @db.Uuid
  departmentNameEn     String     @map("department_name_en")
  departmentNameAr     String     @map("department_name_ar")
  basicSalary          Int        @map("basic_salary")
  workSystem           WorkSystem @map("work_system")
  monthSalary          Int        @map("month_salary")
  /// Rounded for display; deductions use monthSalary ÷ divisor unrounded.
  dayValue             Int        @map("day_value")
  penaltyDays          Decimal    @default(0) @map("penalty_days") @db.Decimal(5, 2)
  penaltyAmount        Int        @default(0) @map("penalty_amount")
  latenessMinutes      Int        @default(0) @map("lateness_minutes")
  latenessDays         Decimal    @default(0) @map("lateness_days") @db.Decimal(5, 2)
  latenessAmount       Int        @default(0) @map("lateness_amount")
  adjustmentAdditions  Int        @default(0) @map("adjustment_additions")
  adjustmentDeductions Int        @default(0) @map("adjustment_deductions")
  net                  Int
  /// `PayrollFlag` values: NET_FLOORED, PENDING_PENALTIES.
  flags                String[]   @default([])
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  run      PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([runId, employeeId])
  @@index([runId])
  @@index([employeeId])
  @@index([departmentId])
  @@map("payroll_lines")
}

/// A one-off addition or deduction on a draft run, with a required reason (§6).
model PayrollAdjustment {
  id          String         @id @default(uuid()) @db.Uuid
  runId       String         @map("run_id") @db.Uuid
  employeeId  String         @map("employee_id") @db.Uuid
  type        AdjustmentType
  /// Piastres, > 0.
  amount      Int
  reason      String
  createdById String?        @map("created_by_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at")

  run       PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee  Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdBy User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([runId])
  @@index([employeeId])
  @@index([createdById])
  @@map("payroll_adjustments")
}
