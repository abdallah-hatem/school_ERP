# Copy to .env.local. Server-only: the browser never calls the API directly.
BASE_URL=http://localhost:3001
# Optional: the API's origin as a browser would reach it, allowed by the pages' CSP (img-src,
# connect-src). Default: BASE_URL's origin. (docs/ARCHITECTURE.md → Security)
# API_PUBLIC_ORIGIN=https://api.example.com
# Cookie names for the access / refresh tokens (httpOnly, set by the auth flow in T2).
NEXT_PUBLIC_AUTH_TOKEN_KEY=auth_token
NEXT_PUBLIC_REFRESH_TOKEN_KEY=refresh_token
# Retry idempotent requests on transient network failures.
ENABLE_API_RETRY=false
