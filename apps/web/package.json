{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "predev": "pnpm --filter @school-erp/shared build",
    "dev": "next dev --port 3000",
    "prebuild": "pnpm --filter @school-erp/shared build",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "echo \"web e2e: Playwright smoke specs arrive in T17\"",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@school-erp/shared": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.4.4",
    "eslint-plugin-i18next": "6.1.5",
    "jsdom": "26.1.0",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "3.2.7"
  }
}
