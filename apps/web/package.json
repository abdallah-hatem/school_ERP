{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port ${WEB_PORT:-3000}",
    "prebuild": "pnpm --filter @school-erp/shared build",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "echo \"web e2e: Playwright smoke specs run with pnpm smoke at the repo root\"",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.6",
    "@phosphor-icons/react": "2.1.10",
    "@school-erp/shared": "workspace:*",
